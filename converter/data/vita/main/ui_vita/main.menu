// the settings page (2026-11-11; instead of the game's settings window; 14 rows 22 apart since 2026-11-18): tabs GRAPHICS and SOUND (L / R), a row per
// setting with its value (left / right or X change it; the focused row's value is shown between arrows), the focused
// setting's description on the right. The engine fills the rows (ui_main.cpp UI_Vita_PageFill: ui_vita_set<n>_label /
// _value, ui_vita_set_count) and changes the values; the pause menu's SETTINGS opens it too (UI_Vita_RedirectSettings),
// and closing it there goes back to the pause menu (bo1_vita_setback). Saved when it closes (UI_Vita_SettingsFrame).
// A section's heading (ui_vita_set<n>_head 1, 2026-11-23: DISPLAY, DETAIL, MAP EFFECTS): its name in amber left of the
// rows' labels over a thin red line, no row button (never focused)
#define SET_SLOT(n, y, lineY, labelDvar, valueDvar, headDvar, focusCmd, actionCmd) 	ROWH(LEFT, 400, 540, 22, 16, 0.33, n, y, exp text( dvarString( labelDvar ) ), 1, 		dvarint( "ui_vita_set_count" ) > n && dvarint( headDvar ) == 0, execnow focusCmd;, execnow actionCmd;) 	LABEL(LEFT, y, 390, 22, 16, FONT_TEXT, 0.3, ALIGN_RIGHT, C_AMBER, 1, exp text( dvarString( valueDvar ) ), 		dvarint( "ui_vita_set_count" ) > n && dvarint( headDvar ) == 0) 	LABEL(LEFT, y, 390, 22, 17, FONT_TEXT, 0.34, ALIGN_LEFT, C_AMBER, 1, exp text( dvarString( labelDvar ) ), 		dvarint( "ui_vita_set_count" ) > n && dvarint( headDvar ) == 1) 	TINT(LEFT, lineY, 390, 1, HA_CENTER, VA_TOP, "white", C_BLOOD, 0.8, 		dvarint( "ui_vita_set_count" ) > n && dvarint( headDvar ) == 1)

// a tab at x (w wide), its number and its name, shown when hd is ui_vita_hdtab (the HD tab's row of five, or four)
#define SET_TAB(x, w, n, name, hd) \
	TINT(x, 104, w, 22, HA_CENTER, VA_TOP, "white", C_BLOOD, 0.9, dvarint( "ui_vita_settab" ) == n && dvarint( "ui_vita_hdtab" ) == hd) \
	TINT(x, 104, w, 22, HA_CENTER, VA_TOP, "white", 0 0 0, 0.45, dvarint( "ui_vita_settab" ) != n && dvarint( "ui_vita_hdtab" ) == hd) \
	LABEL(x, 104, w, 22, 17, FONT_TEXT, 0.3, ALIGN_CENTER, 1 1 1, 1, text name, dvarint( "ui_vita_settab" ) == n && dvarint( "ui_vita_hdtab" ) == hd) \
	LABEL(x, 104, w, 22, 17, FONT_TEXT, 0.3, ALIGN_CENTER, C_BONE, 0.5, text name, dvarint( "ui_vita_settab" ) != n && dvarint( "ui_vita_hdtab" ) == hd)

// (the engine switches only when the tab changes and then focuses the first row - with its sound - once: the keys
// come again and again while L / R are held)
#define SET_TAB_KEYS(key, tab) \
	execKeyInt key { execnow tab; }

menuDef
{
	name			"vitasettings"
	fullscreen		1
	rect			0 0 640 480
	onOpen			{ execnow "bo1_vita_setfill"; setLocalVarInt ui_vita_hl 0; focusfirst; }
	// (in a game the pause menu opens first, in the same script - as the game's settings window did: with the page
	// closed first, the game had resumed by the time a deferred exec ran)
	onESC			{ SND_BACK execnow "bo1_vita_setback"; close vitasettings; }
	execKeyInt KEY_DPAD_LEFT { SND_OVER execnow "bo1_vita_setstep -1"; }
	execKeyInt KEY_DPAD_RIGHT { SND_OVER execnow "bo1_vita_setstep 1"; }
	// up / down: the engine moves the focus and scrolls the rows (a tab may have more rows than the 14 slots)
	execKeyInt KEY_DPAD_UP { execnow "bo1_vita_setmove -1"; }
	execKeyInt KEY_DPAD_DOWN { execnow "bo1_vita_setmove 1"; }
	execKeyInt KEY_APAD_UP { execnow "bo1_vita_setmove -1"; }
	execKeyInt KEY_APAD_DOWN { execnow "bo1_vita_setmove 1"; }
	execKeyInt KEY_UPARROW { execnow "bo1_vita_setmove -1"; }
	execKeyInt KEY_DOWNARROW { execnow "bo1_vita_setmove 1"; }
	// the tabs: L / R (the Vita's shoulder buttons are the gamepad's triggers; the shoulder codes too)
	SET_TAB_KEYS(18, "bo1_vita_settab prev")
	SET_TAB_KEYS(19, "bo1_vita_settab next")
	SET_TAB_KEYS(5, "bo1_vita_settab prev")
	SET_TAB_KEYS(6, "bo1_vita_settab next")

	BACKGROUND("SETTINGS", "ui_vita_sel_art", "ui_vita_sel_art_on", "X / LEFT RIGHT  CHANGE      O  BACK      L / R  TABS")

	// the tabs (GRAPHICS, HD in HD MODE, CONTROLS, SOUND, DEV): the active one bright on a blood-red tab
	SET_TAB(LEFT, 96, 0, "GRAPHICS", 0)
	SET_TAB(-290, 96, 2, "CONTROLS", 0)
	SET_TAB(-190, 96, 3, "SOUND", 0)
	SET_TAB(-90, 96, 4, "DEV", 0)
	SET_TAB(LEFT, 78, 0, "GRAPHICS", 1)
	SET_TAB(-308, 78, 1, "HD", 1)
	SET_TAB(-226, 78, 2, "CONTROLS", 1)
	SET_TAB(-144, 78, 3, "SOUND", 1)
	SET_TAB(-62, 78, 4, "DEV", 1)
	LABEL(14, 104, 60, 22, 17, FONT_SMALL, 0.25, ALIGN_LEFT, C_DIM, 1, text "L / R", 1)

	SET_SLOT(0, 132, 152, "ui_vita_set0_label", "ui_vita_set0_value", "ui_vita_set0_head", "bo1_vita_setfocus 0", "bo1_vita_setaction 0")
	SET_SLOT(1, 154, 174, "ui_vita_set1_label", "ui_vita_set1_value", "ui_vita_set1_head", "bo1_vita_setfocus 1", "bo1_vita_setaction 1")
	SET_SLOT(2, 176, 196, "ui_vita_set2_label", "ui_vita_set2_value", "ui_vita_set2_head", "bo1_vita_setfocus 2", "bo1_vita_setaction 2")
	SET_SLOT(3, 198, 218, "ui_vita_set3_label", "ui_vita_set3_value", "ui_vita_set3_head", "bo1_vita_setfocus 3", "bo1_vita_setaction 3")
	SET_SLOT(4, 220, 240, "ui_vita_set4_label", "ui_vita_set4_value", "ui_vita_set4_head", "bo1_vita_setfocus 4", "bo1_vita_setaction 4")
	SET_SLOT(5, 242, 262, "ui_vita_set5_label", "ui_vita_set5_value", "ui_vita_set5_head", "bo1_vita_setfocus 5", "bo1_vita_setaction 5")
	SET_SLOT(6, 264, 284, "ui_vita_set6_label", "ui_vita_set6_value", "ui_vita_set6_head", "bo1_vita_setfocus 6", "bo1_vita_setaction 6")
	SET_SLOT(7, 286, 306, "ui_vita_set7_label", "ui_vita_set7_value", "ui_vita_set7_head", "bo1_vita_setfocus 7", "bo1_vita_setaction 7")
	SET_SLOT(8, 308, 328, "ui_vita_set8_label", "ui_vita_set8_value", "ui_vita_set8_head", "bo1_vita_setfocus 8", "bo1_vita_setaction 8")
	SET_SLOT(9, 330, 350, "ui_vita_set9_label", "ui_vita_set9_value", "ui_vita_set9_head", "bo1_vita_setfocus 9", "bo1_vita_setaction 9")
	SET_SLOT(10, 352, 372, "ui_vita_set10_label", "ui_vita_set10_value", "ui_vita_set10_head", "bo1_vita_setfocus 10", "bo1_vita_setaction 10")
	SET_SLOT(11, 374, 394, "ui_vita_set11_label", "ui_vita_set11_value", "ui_vita_set11_head", "bo1_vita_setfocus 11", "bo1_vita_setaction 11")
	SET_SLOT(12, 396, 416, "ui_vita_set12_label", "ui_vita_set12_value", "ui_vita_set12_head", "bo1_vita_setfocus 12", "bo1_vita_setaction 12")
	SET_SLOT(13, 418, 438, "ui_vita_set13_label", "ui_vita_set13_value", "ui_vita_set13_head", "bo1_vita_setfocus 13", "bo1_vita_setaction 13")

	// the focused setting: its name and what it does
	TINT(40, 132, 342, 160, HA_CENTER, VA_TOP, "white", 0.02 0.012 0.01, 0.62, 1)
	TINT(40, 132, 342, 2, HA_CENTER, VA_TOP, "white", C_BLOOD, 0.9, 1)
	LABEL(54, 142, 320, 30, 26, FONT_BIG, 0.4, ALIGN_LEFT, 1 1 1, 1, exp text( dvarString( "ui_vita_setname" ) ), 1)
	// more rows than shown: where the focus is, and which way the rest lies
	LABEL(54, 298, 320, 22, 17, FONT_TEXT, 0.28, ALIGN_LEFT, C_AMBER, 0.9, exp text( dvarString( "ui_vita_setmore" ) ), 1)
	itemDef
	{
		type			ITEM_TYPE_TEXT
		rect			54 176 316 110 HA_CENTER VA_TOP
		exp text		( dvarString( "ui_vita_setdesc" ) )
		autowrapped
		textfont		FONT_TEXT
		textscale		0.3
		textalign		ALIGN_LEFT
		textalignx		0
		textaligny		17
		forecolor		C_BONE 0.9
		visible			1
		decoration
	}
}
